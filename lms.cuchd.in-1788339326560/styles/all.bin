ody.moove-child-admin-dashboard .welcome-panel h1,body.moove-child-admin-dashboard .welcome-panel .h1{margin:0 0 7px;color:#fff;font-size:32px;font-weight:800;line-height:1.08;text-shadow:0 2px 12px rgb(0 0 0 / .42)}body.moove-child-admin-dashboard .welcome-panel p{margin:0;color:rgb(255 255 255 / .84);font-weight:600;max-width:48ch}body.moove-child-admin-dashboard .section-head p{margin:0;color:#5f6f8c;font-weight:600}body.moove-child-admin-dashboard .campus-strip{display:none}body.moove-child-admin-dashboard .welcome-panel-right{display:flex;flex-direction:column;align-items:flex-end;justify-content:space-between;gap:8px;justify-self:end;align-self:stretch;position:relative;z-index:2;min-width:0}body.moove-child-admin-dashboard .date-card{display:flex;align-items:center;gap:10px;min-width:156px;padding:11px 14px;background:rgb(255 255 255 / .15);border:1px solid rgb(255 255 255 / .3);border-radius:var(--radius);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);color:#fff;align-self:flex-end}body.moove-child-admin-dashboard .mv-last-updated-badge{display:flex;align-items:center;gap:6px;padding:5px 10px;background:rgb(255 255 255 / .12);border:1px solid rgb(255 255 255 / .22);border-radius:20px;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);color:rgb(255 255 255 / .82);font-size:11px;font-weight:500;white-space:nowrap;cursor:default;align-self:flex-end;margin-top:2px}body.moove-child-admin-dashboard .mv-last-updated-badge svg{flex-shrink:0;opacity:.78}body.moove-child-admin-dashboard .mv-last-updated-badge strong{color:#fff;font-weight:700}body.moove-child-admin-dashboard .date-card strong,body.moove-child-admin-dashboard .date-card small,body.moove-child-admin-dashboard .date-card .small{display:block;color:#fff}body.moove-child-admin-dashboard .date-card small,body.moove-child-admin-dashboard .date-card .small{color:rgb(255 255 255 / .72);font-weight:600}body.moove-child-admin-dashboard .filter-bar{display:flex;grid-template-columns:1.1fr 1.25fr 1fr 1.2fr 0.9fr;gap:14px;margin-top:12px;padding:18px 20px;background:var(--surface);border:1px solid #dfe8f4;border-radius:16px;box-shadow:0 16px 34px rgb(28 39 68 / .06)}body.moove-child-admin-dashboard .filter-field{position:relative;display:grid;grid-template-columns:40px 1fr;grid-template-rows:auto auto;align-items:center;gap:2px 12px;min-width:0;width:16%;min-height:62px;padding:10px 38px 10px 10px;background:#fff;border:1px solid #dce7f3;border-radius:12px;box-shadow:0 10px 22px rgb(35 45 65 / .04);cursor:pointer;transition:border-color 180ms ease,box-shadow 180ms ease,transform 180ms ease}body.moove-child-admin-dashboard .filter-icon{grid-row:1 / span 2;display:grid;width:40px;height:40px;place-items:center;color:var(--filter-color);background:color-mix(in srgb,var(--filter-color),transparent 88%);border-radius:13px}body.moove-child-admin-dashboard .filter-icon svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:2.25}body.moove-child-admin-dashboard .filter-copy{grid-column:2;grid-row:1;align-self:end;min-width:0;pointer-events:none}body.moove-child-admin-dashboard .filter-copy span{display:block;color:#61708a;font-size:11px;font-weight:800}body.moove-child-admin-dashboard .filter-bar select{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}body.moove-child-admin-dashboard .active-filters-bar{display:flex;align-items:center;flex-wrap:wrap;gap:8px;padding:10px 18px;background:var(--surface);border:1.5px solid var(--line);border-radius:var(--radius);animation:afBarIn 0.18s ease}@keyframes afBarIn{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}body.moove-child-admin-dashboard .active-filters-label{font-size:12px;font-weight:600;color:var(--muted);white-space:nowrap;margin-right:4px}body.moove-child-admin-dashboard .active-filters-list{display:flex;flex-wrap:wrap;gap:6px;flex:1}body.moove-child-admin-dashboard .active-filter-badge{display:inline-flex;align-items:center;gap:5px;padding:4px 10px 4px 12px;background:#eef3ff;border:1.5px solid #c7d7ff;border-radius:999px;font-size:12px;color:#3b5bdb;font-weight:500;white-space:nowrap}body.moove-child-admin-dashboard .active-filter-badge strong{font-weight:700}body.moove-child-admin-dashboard .active-filter-badge .af-remove{background:none;border:none;padding:0 0 0 2px;margin:0;font-size:15px;line-height:1;color:#8898cc;cursor:pointer;transition:color 0.15s}body.moove-child-admin-dashboard .active-filter-badge .af-remove:hover{color:var(--red)}body.moove-child-admin-dashboard .active-filters-reset{display:inline-flex;align-items:center;gap:5px;margin-left:auto;padding:5px 13px;background:none;border:1.5px solid var(--line);border-radius:999px;font-size:12px;font-weight:600;color:var(--muted);white-space:nowrap;transition:border-color 0.15s,color 0.15s,background 0.15s}body.moove-child-admin-dashboard .active-filters-reset:hover{border-color:var(--red);color:var(--red);background:#fff0f3}body.moove-child-admin-dashboard .active-filters-reset svg{flex-shrink:0}body.moove-child-admin-dashboard .filter-submit-btn,body.moove-child-hod-dashboard .filter-submit-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;align-self:center;flex-shrink:0;padding:0 22px;height:44px;background:#1f87ff;color:#fff;border:none;border-radius:12px;font-size:13px;font-weight:700;letter-spacing:.01em;cursor:pointer;white-space:nowrap;box-shadow:0 4px 14px rgb(31 135 255 / .28);transition:background 0.15s,box-shadow 0.15s,transform 0.12s}body.moove-child-admin-dashboard .filter-submit-btn svg,body.moove-child-hod-dashboard .filter-submit-btn svg{flex-shrink:0;stroke:#fff}body.moove-child-admin-dashboard .filter-submit-btn:hover,body.moove-child-hod-dashboard .filter-submit-btn:hover{background:#1470e0;box-shadow:0 6px 18px rgb(31 135 255 / .38);transform:translateY(-1px)}body.moove-child-admin-dashboard .filter-submit-btn:active,body.moove-child-hod-dashboard .filter-