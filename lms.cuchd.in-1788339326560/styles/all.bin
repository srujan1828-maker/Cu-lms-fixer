y-index[data-bs-theme="dark"]{--db-brand:#ff4d4f;--db-text:#e2e8f0;--db-muted:#64748b;--db-line:rgba(255, 255, 255, 0.08);--db-surface:#1e2530;--db-bg:#151a1e}.db-container{padding:32px 0 64px}.db-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:24px}.db-grid>*{min-width:0}.db-card{background:var(--db-surface);border-radius:24px;padding:28px;border:1px solid var(--db-line);box-shadow:0 4px 20px rgb(0 0 0 / .03);min-width:0}.db-card-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}.db-card-title{font-size:15px;font-weight:800;margin:0;color:var(--db-text)}.db-card-subtitle{margin:4px 0 0;font-size:13px;color:var(--db-muted)}.db-card-footer{margin-top:auto;padding-top:16px;border-top:1px solid var(--db-line)}.db-view-all-link{color:var(--db-brand);font-size:12px;font-weight:700;text-decoration:none;transition:opacity 0.2s}.db-view-all-link:hover{opacity:.8;color:var(--db-brand)}.db-link-btn{font-size:13px;font-weight:700;padding:10px 18px;border-radius:8px;border:1px solid rgb(229 9 20 / .15);color:var(--db-brand);background:var(--db-surface);display:inline-block;text-decoration:none;transition:all 0.2s}.db-link-btn:hover{background:rgb(229 9 20 / .05);color:var(--db-brand)}.db-chart-wrapper{width:100%;overflow:hidden;position:relative;min-height:220px}.db-chart-wrapper canvas{width:100%!important;max-height:260px}.db-chart-wrapper .chart-table-expand,.db-chart-wrapper [data-action="toggle-table"],.db-chart-wrapper .chart-table-expand-btn,.db-chart-wrapper .chart-table-data,.db-chart-wrapper .chart-table{display:none!important}.db-cp-list{display:flex;flex-direction:column;gap:18px;flex:1;min-height:0;list-style:none;margin:0;padding:0;overflow-y:auto;max-height:340px}.db-cp-item{display:flex;flex-direction:column;gap:6px}.db-cp-info{display:flex;justify-content:space-between;align-items:center;gap:8px}.db-cp-name{font-size:12px;font-weight:600;color:var(--db-text);white-space:nowrap;overflow:hidden;text-overflow:ellips