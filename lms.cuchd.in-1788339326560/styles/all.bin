nslateY(-68%) rotate(45deg);pointer-events:none;transition:border-color 180ms ease,transform 180ms ease,opacity 180ms ease}body.moove-child-admin-dashboard .filter-field:hover,body.moove-child-admin-dashboard .filter-field:focus-within,body.moove-child-admin-dashboard .filter-field.is-open{border-color:#9ed0ff;box-shadow:0 0 0 3px rgb(31 135 255 / .12)}body.moove-child-admin-dashboard .filter-field.is-open{z-index:15;transform:translateY(-1px)}body.moove-child-admin-dashboard .filter-field.is-open::after{border-color:var(--filter-color);transform:translateY(-24%) rotate(225deg)}body.moove-child-admin-dashboard .filter-field.is-open .custom-select-menu{opacity:1;pointer-events:auto;transform:translateY(0) scale(1)}body.moove-child-admin-dashboard .filter-field.is-disabled{opacity:.46;filter:blur(.35px) grayscale(.25);cursor:not-allowed}body.moove-child-admin-dashboard .filter-field.violet{--filter-color:#7565ff}body.moove-child-admin-dashboard .filter-field.blue{--filter-color:#2f86ff}body.moove-child-admin-dashboard .filter-field.green{--filter-color:#2fc767}body.moove-child-admin-dashboard .filter-field.teal{--filter-color:#0ab5a8}body.moove-child-admin-dashboard .filter-field.purple{--filter-color:#9747e6}body.moove-child-admin-dashboard .filter-field.green{--filter-color:#2fc767}body.moove-child-admin-dashboard .filter-field.teal{--filter-color:#0ab5a8}body.moove-child-admin-dashboard .filter-field.purple{--filter-color:#9747e6}body.moove-child-admin-dashboard .filter-field.orange{--filter-color:#ff7b22}body.moove-child-admin-dashboard .prog-multi-wrap{grid-column:2;grid-row:2;position:relative;z-index:2;display:block;width:100%;min-width:0}body.moove-child-admin-dashboard .prog-multi-trigger{display:block;width:100%;background:#fff0;border:0;padding:0;text-align:left;cursor:pointer;outline:none}body.moove-child-admin-dashboard .prog-multi-trigger[aria-disabled="true"]{cursor:not-allowed;opacity:.5}body.moove-child-admin-dashboard .prog-multi-text{display:block;width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;font-weight:900;color:#1b253b;line-height:1.2}body.moove-child-admin-dashboard .prog-multi-menu{left:-52px;right:-30px;min-width:200px;max-height:none;padding:4px 0;overflow:visible}body.moove-child-admin-dashboard .prog-multi-header{display:flex;align-items:center;justify-content:space-between;padding:8px 10px 6px;border-bottom:1px solid #f0f4f8;font-size:11px;font-weight:700;color:#8898b2;letter-spacing:.05em;text-transform:uppercase;list-style:none}body.moove-child-admin-dashboard .prog-multi-badge{display:inline-flex;align-items:center;justify-content:center;width:17px;height:17px;margin-left:5px;background:var(--filter-color);color:#fff;border-radius:50%;font-size:10px;font-weight:800;vertical-align:middle}body.moove-child-admin-dashboard .prog-multi-clear{background:none;border:none;padding:0;cursor:pointer;font-size:11px;font-weight:600;color:var(--filter-color);opacity:0;pointer-events:none;transition:opacity 150ms}body.moove-child-admin-dashboard .prog-multi-clear.visible{opacity:1;pointer-events:auto}body.moove-child-admin-dashboard .prog-multi-list-wrap{list-style:none;padding:0;margin:0}body.moove-child-admin-dashboard .prog-multi-list{max-height:210px;overflow-y:auto;padding:4px 0;margin:0;list-style:none}body.moove-child-admin-dashboard .prog-multi-item{display:flex;align-items:center;gap:8px;padding:8px 10px;cursor:pointer}body.moove-child-admin-dashboard .prog-multi-item input[type="checkbox"]{flex-shrink:0;width:14px;height:14px;accent-color:var(--filter-color);cursor:pointer}body.moove-child-admin-dashboard .prog-multi-item span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}body.moove-child-admin-dashboard .prog-multi-item:hover{color:var(--filter-color);background:color-mix(in srgb,var(--filter-color),transparent 90%);transform:translateX(2px)}body.moove-child-admin-dashboard .prog-multi-item.is-selected{color:#fff;background:var(--filter-color)}b