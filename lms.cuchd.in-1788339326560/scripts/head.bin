if(chartInstance.options&&chartInstance.options.plugins&&chartInstance.options.plugins.tooltip){var originalLabelCallback=chartInstance.options.plugins.tooltip.callbacks.label;chartInstance.options.plugins.tooltip.callbacks.label=function(context){var label=originalLabelCallback?originalLabelCallback.call(this,context):'';if(Array.isArray(label)){return label.map(function(item){return item.replace(/: (\d+)(?!%)$/,': $1%')})}else if(typeof label==='string'){return label.replace(/: (\d+)(?!%)$/,': $1%')}
return label};chartInstance._tooltipModified=!0;chartInstance.update('none')}}}catch(e){console.debug('Chart not ready:',e)}}});$('.time-allocation-chart-wrapper .chart-table-data table td').each(function(){var $td=$(this);var text=$td.text().trim();if(/^\d+$/.test(text)&&!$td.data('formatted')){$td.text(text+'%');$td.data('formatted',!0)}})}
modifyChartTooltips();setTimeout(modifyChartTooltips,500);setTimeout(modifyChartTooltips,1000);setTimeout(modifyChartTooltips,2000);var observer=new MutationObserver(function(mutations){modifyChartTooltips()});var chartWrapper=document.querySelector('.time-allocation-chart-wrapper');if(chartWrapper){observer.observe(chartWrapper,{childList:!0,subtree:!0})}
