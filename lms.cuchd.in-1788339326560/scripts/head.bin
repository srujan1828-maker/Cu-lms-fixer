if(htmlTheme==='dark'||htmlTheme==='light'){return htmlTheme}
if(document.body.classList.contains('moove-darkmode')||document.body.classList.contains('darkmode')||document.body.classList.contains('dark-mode')){return'dark'}
return'light'}
function persistMoodleDarkModePreference(theme){return}
var syncingThemeMirror=!1;function mirrorMoodleThemeState(){if(!document.body||syncingThemeMirror){return}
syncingThemeMirror=!0;var theme=(document.body.classList.contains('moove-darkmode')||document.body.getAttribute('data-bs-theme')==='dark')?'dark':'light';var isDark=theme==='dark';document.body.setAttribute('data-bs-theme',theme);document.documentElement.setAttribute('data-bs-theme',theme);document.body.classList.toggle('moove-darkmode',isDark);document.body.classList.toggle('darkmode',isDark);document.body.classList.toggle('dark-mode',isDark);document.querySelectorAll('#toggle-darkmode-input').forEach(function(input){input.checked=isDark;if(isDark){input.setAttribute('checked','checked')}else{input.removeAttribute('checked')}});window.setTimeout(function(){syncingThemeMirror=!1},0)}
function installMoodleThemeMirror(){if(!document.body||document.body.dataset.mooveChildThemeMirror==='1'){return}
