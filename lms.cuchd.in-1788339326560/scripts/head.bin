var nearby=holder;var nearbyDescriptor='';var hasNearbyThemeIcon=!1;for(var i=0;nearby&&i<4;i++){nearbyDescriptor+=' '+[nearby.id,nearby.className,nearby.getAttribute&&nearby.getAttribute('aria-label'),nearby.getAttribute&&nearby.getAttribute('title'),nearby.getAttribute&&nearby.getAttribute('data-bs-theme-value'),nearby.getAttribute&&nearby.getAttribute('data-theme'),nearby.textContent].join(' ');if(nearby.querySelector&&nearby.querySelector('[class*="sun"], [class*="moon"], .fa-sun, .fa-moon, .bi-sun, .bi-moon')){hasNearbyThemeIcon=!0}
if(nearby.classList&&nearby.classList.contains('navbar')){break}
nearby=nearby.parentElement}
var descriptor=[holder.id,holder.className,holder.getAttribute('aria-label'),holder.getAttribute('title'),holder.getAttribute('data-bs-theme-value'),holder.getAttribute('data-theme'),holder.textContent,nearbyDescriptor].join(' ').toLowerCase();if(descriptor.indexOf('edit mode')!==-1||descriptor.indexOf('editmode')!==-1){return!1}
return descriptor.indexOf('theme')!==-1||descriptor.indexOf('dark')!==-1||descriptor.indexOf('light')!==-1||hasNearbyThemeIcon}
function installHomeThemeFallback(){if(!document.body||document.body.id!=='page-site-index'){return}
setCurrentTheme(getCurrentTheme());var handleThemeInteraction=function(event){var control=event.target.closest('input, button, a, label, [role="button"], [data-bs-theme-value], [data-theme]');if(!isThemeControl(control)){return}
var before=getCurrentTheme();window.setTimeout(function(){var after=getCurrentTheme();if(after===before){after=before==='dark'?'light':'dark'}
setCurrentTheme(after);persistMoodleDarkModePreference(after)},120)};document.addEventListener('click',handleThemeInteraction,!0);document.addEventListener('change',handleThemeInteraction,!0)}
installHomeThemeFallback();installMoodleThemeMirror();(function installAdminDarkMode(){var body=document.body;if(!body)return;var isAdminDash=body.classList.contains('moove-child-admin-dashboard');var isHodDash=body.classList.contains('moove-child-hod-dashboard');if(!isAdminDash&&!isHodDash)return;function applyTheme(theme){var isDark=theme==='dark';body.setAttribute('data-bs-theme',theme);document.documentElement.setAttribute('data-bs-theme',theme);body.classList.toggle('moove-darkmode',isDark);body.classList.toggle('darkmode',isDark);body.classList.toggle('dark-mode',isDark);document.querySelectorAll('[data-bs-theme-value]').forEach(function(el){var active=el.getAttribute('data-bs-theme-value')===theme;el.classList.toggle('active',active);el.setAttribute('aria-pressed',active?'true':'false')});document.querySelectorAll('.navbar input[type="checkbox"], .navbar input[type="radio"]').forEach(function(input){var holder=input.closest('label, .form-switch, .custom-control, .theme-switch, .darkmode-switch, .theme-toggle');if(!holder)return;var desc=(holder.className+' '+(holder.getAttribute('aria-label')||'')+' '+(holder.textContent||'')).toLowerCase();if(desc.indexOf('theme')!==-1||desc.indexOf('dark')!==-1||desc.indexOf('light')!==-1){input.checked=(theme==='dark');if(theme==='dark'){input.setAttribute('checked','checked')}else{input.removeAttribute('checked')}}})}
applyTheme(body.classList.contains('moove-darkmode')||body.getAttribute('data-bs-theme')==='dark'?'dark':'light');function isNavbarThemeToggle(el){if(!el)return!1;if(el.closest('#toggle-darkmode, #toggle-darkmode-input'))return!1;if(!el.closest('#toggle-darkmode, #toggle-darkmode-input, [data-bs-theme-value], [data-theme]'))return!1;var scope=el.closest('.navbar, .accessibilitybar, [data-region*="theme"], [class*="darkmode"]');if(!scope)return!1;if(el.closest('.editmode-switch-form, [data-region="edit-mode-switch"], form[action*="setmode"]'))return!1;var walk=el;var descriptor='';var hasSunMoon=!1;for(var i=0;walk&&i<4;i++){descriptor+=' '+[walk.id||'',walk.className||'',walk.getAttribute?(walk.getAttribute('aria-label')||''):'',walk.getAttribute?(walk.getAttribute('data-bs-theme-value')||''):'',walk.textContent||''].join(' ');if(walk.querySelector&&walk.querySelector('[class*="sun"],[class*="moon"],.fa-sun,.fa-moon,.bi-sun,.bi-moon')){hasSunMoon=!0}
if(walk.classList&&walk.classList.contains('navbar'))break;walk=walk.parentElement}
descriptor=descriptor.toLowerCase();if(descriptor.indexOf('edit mode')!==-1||descriptor.indexOf('editmode')!==-1)return!1;return hasSunMoon||descriptor.indexOf('theme')!==-1||descriptor.indexOf('dark')!==-1||descriptor.indexOf('light')!==-1}
document.addEventListener('click',function(e){var el=e.target.closest('input, button, a, label, [role="button"], [data-bs-theme-value], [data-theme]');if(!isNavbarThemeToggle(el))return;var before=body.getAttribute('data-bs-theme')||'light';setTimeout(function(){var after=body.getAttribute('data-bs-theme')||'light';if(after===before){after=before==='dark'?'light':'dark'}
