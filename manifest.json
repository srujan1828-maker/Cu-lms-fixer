{
  "manifest_version": 3,
  "name": "CU-LMS Fixer",
  "version": "1.4.0",
  "description": "Adds one-click download buttons to file resources, copy buttons to reading pages, and customizable SOP popup controls on CU LMS.",
  "permissions": ["downloads", "clipboardWrite", "storage"],
  "host_permissions": ["https://lms.cuchd.in/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://lms.cuchd.in/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
